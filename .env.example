# Copy to .env (gitignored) and fill in what you use.

# ElevenLabs: the only key the pipeline needs (scripts/synth.py).
ELEVENLABS_API_KEY=

# Optional. If ELEVENLABS_API_KEY is unset, the scripts read the key from the
# AWS SSM parameter /outcomeops-video-gen/eleven-labs instead, which is how
# OutcomeOps runs it. Only then do you need AWS credentials (here or in
# ~/.aws/credentials).
AWS_REGION=us-west-2
