# AWS — used for both Bedrock (Claude script generation) and Polly (TTS).
# Bedrock model: us.anthropic.claude-sonnet-4-6 must be enabled in
# this region. Sonnet 4.6 in us-west-2 is the default.
#
# If you've already configured ~/.aws/credentials these can stay blank.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-west-2
