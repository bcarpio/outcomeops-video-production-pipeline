# Copy to .env (gitignored) and fill in what you use.

# ElevenLabs: the only key the demos pipeline needs (scripts/synth.py).
# If unset, the scripts fall back to the SSM parameter
# /outcomeops-video-gen/eleven-labs, which is how OutcomeOps runs it.
ELEVENLABS_API_KEY=

# AWS: only for the SSM fallback above and the legacy YAML pipeline
# (generate.py: Bedrock writes narration, Polly speaks it). Leave blank if
# you use ~/.aws/credentials. Bedrock model us.anthropic.claude-sonnet-4-6
# must be enabled in this region.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-west-2
